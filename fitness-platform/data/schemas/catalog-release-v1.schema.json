{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momentum.local/schemas/catalog-release-v1.schema.json",
  "title": "Momentum catalog release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "content_hash", "published_at", "batch_id", "muscles", "equipment", "exercises"],
  "properties": {
    "schema_version": {"const": "1"},
    "catalog_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "published_at": {"type": "string", "format": "date-time"},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "muscles": {"type": "array", "items": {"$ref": "#/$defs/facet"}},
    "equipment": {"type": "array", "items": {"$ref": "#/$defs/facet"}},
    "exercises": {"type": "array", "items": {"$ref": "#/$defs/exercise"}}
  },
  "$defs": {
    "facet": {
      "type": "object", "additionalProperties": false, "required": ["slug", "name"],
      "properties": {"slug": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "name": {"type": "string", "minLength": 1}}
    },
    "muscleRef": {
      "type": "object", "additionalProperties": false, "required": ["slug", "role"],
      "properties": {"slug": {"type": "string"}, "role": {"enum": ["PRIMARY", "SECONDARY"]}}
    },
    "exercise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "external_id", "version", "name", "description", "tracking_type", "muscles", "equipment", "status", "reviewed", "provenance", "license_name", "license_url"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "source": {"type": "string", "minLength": 1},
        "external_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}, "description": {"type": "string"},
        "tracking_type": {"enum": ["REPS", "REPS_WEIGHT", "DURATION", "DISTANCE"]},
        "muscles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/muscleRef"}},
        "equipment": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["DRAFT", "PUBLISHED", "DEPRECATED"]}, "reviewed": {"type": "boolean"},
        "provenance": {"type": "string", "minLength": 1}, "license_name": {"type": "string", "minLength": 1},
        "license_url": {"type": "string", "format": "uri"}
      }
    }
  }
}
