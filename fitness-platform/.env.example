# Copy to .env for local Docker development. Never commit real secrets.
POSTGRES_DB=fitness
POSTGRES_USER=fitness
POSTGRES_PASSWORD=local-fitness-password
FITNESS_ENVIRONMENT=local
FITNESS_DATABASE_URL=postgresql+asyncpg://fitness:local-fitness-password@postgres:5432/fitness
FITNESS_REDIS_URL=redis://redis:6379/0
FITNESS_LOG_LEVEL=INFO
FITNESS_CORS_ORIGINS=["http://localhost:3000"]
FITNESS_GUEST_TOKEN_PEPPER=replace-before-any-shared-deployment
FITNESS_ENABLE_DOCS=true
